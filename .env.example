# Copy to .env for local testing, or set as Environment vars on the Komodo Stack in production.
# BAZARR_API_KEY e' um segredo real - SO no Komodo Stack environment, nunca
# commitado aqui com valor real.

REGISTRY=192.168.1.2:3000/salaroli
IMAGE_TAG=latest

BAZARR_BASE_URL=http://192.168.1.2:6767/
BAZARR_API_KEY=
BASE_LANGUAGES=en
TO_LANGUAGES=pb
MIN_SCORE=86
NUM_WORKERS=1
INTERVAL_BETWEEN_SCANS=300
ACTION_COOLDOWN_SECONDS=3600
SERIES_SCAN=true
MOVIES_SCAN=true
LOG_LEVEL=INFO
TRANSLATION_REQUEST_TIMEOUT=1800
SOURCE_PROFILE_ID=
TARGET_PROFILE_ID=
LOG_PATH=/mnt/nvme/appdata/bazarr-autotranslate
